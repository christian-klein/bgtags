# bgtags environment configuration sample
PORT=8080
# Optional: Set public domain (e.g. https://bgtags.cklein.us). If left blank/commented out,
# bgtags will automatically detect the client IP and port or reverse proxy headers.
# BASE_URL=https://bgtags.cklein.us
DB_PATH=/app/data/bgtags.db
DATA_DIR=/app/data
STATIC_DIR=/app/static

# Automated backups
BACKUP_ENABLED=true
BACKUP_DIR=/app/backups
BACKUP_TIME=00:00
BACKUP_RETENTION=30
